# Copie para .env e preencha. Nunca versione o .env.
# Na Vercel, cadastre as mesmas variáveis em Project Settings > Environment Variables.

# --- Banco (Neon) -------------------------------------------------------------
# A integração Neon da Vercel cria as duas automaticamente.
# Pooled (com "-pooler" no host): usada pelo app nas funções serverless.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Direta (sem "-pooler"): usada só pelo `prisma migrate deploy` no build.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- IA (Anthropic) -----------------------------------------------------------
# Chave em https://console.anthropic.com > API Keys. Sem ela, a classificação cai no
# fallback "morno" e a resposta personalizada fica como etapa com erro.
ANTHROPIC_API_KEY=""
# Modelo barato e rápido. Trocar de provedor = editar só src/lib/ai.ts.
AI_MODEL="claude-haiku-5-5"
# Tempo máximo por chamada à IA, em milissegundos.
AI_TIMEOUT_MS="8000"

# --- E-mail (Resend) ----------------------------------------------------------
# Chave em https://resend.com/api-keys
RESEND_API_KEY=""
# Remetente. Sem domínio verificado, use o sandbox do Resend, que só entrega
# para o e-mail dono da conta Resend.
EMAIL_FROM="Lume Estética Automotiva <onboarding@resend.dev>"
# Para onde vai o aviso de novo lead (fora do modo demo).
TEAM_EMAIL=""

# --- Modo demonstração --------------------------------------------------------
# "true": TODO e-mail (ao cliente e à equipe) vai só para DEMO_RECIPIENT,
# nunca para o endereço digitado no formulário. Mantenha "true" na demo pública.
DEMO_MODE="true"
# Seu e-mail. Com o sandbox do Resend, precisa ser o e-mail da sua conta Resend.
# Vazio = etapas de e-mail ficam como "pulada".
DEMO_RECIPIENT=""

# --- Controle de custo e abuso ------------------------------------------------
# Pedidos aceitos por IP por hora.
RATE_LIMIT_PER_HOUR="5"
# Leads processados por dia (UTC) no total. Ao atingir, a IA não é chamada.
DAILY_LEAD_LIMIT="50"
# Segredo para gerar o hash do IP (o IP puro nunca é salvo). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=""

# --- Reset dos dados de demonstração -----------------------------------------
# Token exigido por POST /api/demo/reset. Gere um valor longo e aleatório (mesmo comando acima).
RESET_TOKEN=""
